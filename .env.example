# Copy to .env (git-ignored) to use the optional LLM judge. Nothing is sent anywhere unless you pass --judge llm.
# Provider: "anthropic" (Messages API) or "openai" (ANY OpenAI-compatible endpoint: OpenAI, Gemini, Groq, Ollama...)
LLM_PROVIDER=anthropic
# Model names change often - copy the current one from your provider's docs.
LLM_MODEL=
LLM_API_KEY=
# Only for OpenAI-compatible providers other than OpenAI itself, e.g.
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   Groq   : https://api.groq.com/openai/v1
#   Ollama : http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=
